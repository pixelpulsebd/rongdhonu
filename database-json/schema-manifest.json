    "admin_users": {
      "file": "rongdhonu-db-admin_users.json",
      "primaryKey": [
        "id"
      ],
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "nullable": false,
          "description": "Unique admin ID"
        },
        {
          "name": "email",
          "type": "string",
          "nullable": false,
          "unique": true
        },
        {
          "name": "password_hash",
          "type": "string",
          "nullable": false,
          "description": "bcrypt password hash; never plaintext"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "nullable": false,
          "description": "Created timestamp; admin login only reads id, email and password_hash."
        }
